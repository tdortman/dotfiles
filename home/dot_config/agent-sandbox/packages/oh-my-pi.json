{
  "network": {
    "direct": {
      "allow": [],
      "deny": []
    },
    "http": {
      "allow": [
        { "methods": ["GET"], "url": "https://catalog.stencil.so/models.json.zstd", "port": 443, "comment": "global_package" }
      ],
      "deny": []
    }
  },
  "sudo": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      { "path": "./.omp", "access": "read", "comment": "global_package" },
      { "path": "~/.config/orca/agent-hooks", "access": "read", "comment": "global_package" },
      { "path": "~/.local/share/omp", "access": "read", "comment": "global_package" },
      { "path": "~/.pi/agent/ayu/checkpoints/sessions", "access": "write", "comment": "global_package" },
      { "path": "~/dotfiles/home/dot_local/share/private_omp", "access": "read", "comment": "global_package" },
      { "path": "~/dotfiles/home/dot_omp", "access": "read_write", "comment": "global_package" }
    ],
    "deny": []
  },
  "resources": {
    "allow": [
      { "kind": "unix_socket", "path": "~/.local/state/omp", "access": "connect", "comment": "global_package" }
    ],
    "deny": []
  },
  "dbus": {
    "allow": [
      {
        "target": {
          "bus": "system",
          "destination": "org.freedesktop.login1",
          "object_path": "/org/freedesktop/login1",
          "interface": "org.freedesktop.login1.Manager",
          "member": "Inhibit",
          "message_kind": "method_call",
          "signature": "(ssss)",
          "fd_metadata": []
        },
        "comment": "global_package"
      }
    ],
    "deny": []
  }
}
