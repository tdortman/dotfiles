use_nom_flake() {
  if (( $# == 0 )); then
    set -- .
  fi

  local -a args=("$@")
  _nix() {
    if [[ "$1" == "print-dev-env" ]]; then
      shift
      {
        ${_nix_direnv_nix} --no-warn-dirty --extra-experimental-features "nix-command flakes" \
          print-dev-env --log-format internal-json -v "$@" 2>&1 1>&3 | {
            TERN_TSP=0 nom --json >&2 || cat >&2
          }
      } 3>&1
    else
      ${_nix_direnv_nix} --no-warn-dirty --extra-experimental-features "nix-command flakes" "$@"
    fi
  }

  use flake "${args[@]}"
}
