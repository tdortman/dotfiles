{
    "active_pane_modifiers": {},
    "ui_font_weight": 200.0,
    "agent_ui_font_size": 20.0,
    "agent_buffer_font_size": 18.0,
    "agent_servers": {
        "opencode": {
            "type": "registry",
        },
    },
    "file_finder": {
        "file_icons": true,
    },
    "search": {
        "include_ignored": true,
    },
    "message_editor": {
        "auto_replace_emoji_shortcode": true,
    },
    "preferred_line_length": 100,
    "vim": {
        "toggle_relative_line_numbers": true,
    },
    "scrollbar": {
        "selected_text": true,
        "git_diff": true,
        "selected_symbol": true,
        "show": "auto",
    },
    "gutter": {
        "folds": true,
        "line_numbers": true,
    },
    "double_click_in_multibuffer": "open",
    "show_wrap_guides": true,
    "ui_font_size": 20.0,
    "auto_update": false,
    "restore_on_startup": "last_session",
    "text_rendering_mode": "platform_default",
    "buffer_line_height": "standard",
    "use_system_path_prompts": true,
    "edit_predictions": {
        "provider": "zed",
    },
    "colorize_brackets": true,
    "collaboration_panel": {
        "button": true,
    },
    "debugger": {
        "dock": "left",
    },
    "outline_panel": {
        "file_icons": true,
        "button": true,
    },
    "use_system_window_tabs": false,
    "bottom_dock_layout": "contained",
    "tabs": {
        "file_icons": false,
        "git_status": false,
    },
    "title_bar": {
        "show_user_menu": true,
        "show_sign_in": true,
        "show_branch_name": true,
        "show_branch_icon": true,
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
    },
    "middle_click_paste": false,
    "inlay_hints": {
        "show_background": false,
        "show_other_hints": false,
        "show_parameter_hints": false,
        "show_type_hints": false,
        "enabled": true,
    },
    "soft_wrap": "editor_width",
    "toolbar": {
        "code_actions": true,
        "quick_actions": true,
        "breadcrumbs": true,
    },
    "minimap": {
        "show": "never",
    },
    "relative_line_numbers": "disabled",
    "auto_signature_help": false,
    "sticky_scroll": {
        "enabled": true,
    },
    "rounded_selection": true,
    "project_panel": {
        "hide_hidden": false,
        "scrollbar": {
            "show": "auto",
        },
        "indent_size": 20.0,
        "folder_icons": true,
        "dock": "left",
        "button": true,
        "auto_reveal_entries": false,
    },
    "icon_theme": "Material Icon Theme",
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-5.3-codex",
        },
        "button": true,
    },
    "theme": "One Dark Pro Max",
    "buffer_font_size": 18.0,
    "buffer_font_features": {
        "calt": true,
    },
    "autosave": {
        "after_delay": {
            "milliseconds": 200,
        },
    },
    "ui_font_family": "Mozilla Text",
    "buffer_font_family": "ComicCodeLigatures Nerd Font Mono",
    "buffer_font_weight": 200.0,
    "terminal": {
        "button": true,
        "minimum_contrast": 0,
        "toolbar": {
            "breadcrumbs": false,
        },
        "dock": "right",
        "shell": {
            "with_arguments": {
                "title_override": "HostShell",
                "program": "antigravity-shell",
                "args": [],
            },
        },
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default",
            },
        },
        "cursor_shape": "bar",
        "copy_on_select": true,
        "font_weight": 300,
        "font_features": {
            "calt": true,
            "liga": true,
        },
        "font_family": "ComicCodeLigatures Nerd Font Mono",
    },
    "indent_guides": {
        "line_width": 1,
        "coloring": "fixed",
        "background_coloring": "disabled",
        "enabled": true,
    },
    "tab_size": 4,
    "format_on_save": "off",
    "languages": {
        "Python": {
            "language_servers": [
                // Disable basedpyright and enable ty, and otherwise
                // use the default configuration.
                "ty",
                "!basedpyright",
                "...",
            ],
            "formatter": {
                "external": {
                    "command": "ruff",
                    "arguments": ["format", "-"],
                },
            },
        },
        "TypeScript": {
            "code_actions_on_format": {
                "source.organizeImports": true,
                "source.fixAll.biome": true,
                "source.organizeImports.biome": true,
            },
        },
        "TSX": {
            "code_actions_on_format": {
                "source.organizeImports": true,
            },
        },
        "Nix": {
            "tab_size": 2,
            "language_servers": ["nixd"],
        },
    },
    "lsp": {
        "nixd": {
            "settings": {
                "formatting": {
                    "command": ["nixfmt"],
                },
                "nixpkgs": {
                    "expr": "import (builtins.getFlake(toString ./.)).inputs.nixpkgs { }",
                },
                "options": {
                    "nixos": {
                        "expr": "(builtins.getFlake \"/home/tim/dotfiles\").nixosConfigurations.nixos-pc.options",
                    },
                    "home-manager": {
                        "expr": "(builtins.getFlake \"/home/tim/dotfiles\").nixosConfigurations.nixos-pc.options.home-manager.users.type.getSubOptions []",
                    },
                },
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                    "extraArgs": [
                        "--",
                        "-W",
                        "clippy::pedantic",
                        "-W",
                        "clippy::nursery",
                        "-A",
                        "clippy::option-if-let-else",
                        "-A",
                        "clippy::or_fun_call",
                        "-A",
                        "clippy::module-name-repetitions",
                        "-A",
                        "clippy::struct-excessive-bools",
                        "-A",
                        "clippy::unused-async",
                        "-A",
                        "clippy::missing-const-for-fn",
                        "-A",
                        "clippy::similar-names",
                        "-A",
                        "clippy::enum_variant_names",
                        "-A",
                        "clippy::too-many-lines",
                        "-A",
                        "clippy::ignored-unit-patterns",
                        "-A",
                        "clippy::must-use-candidate",
                        "-A",
                        "clippy::cast-lossless",
                        "-A",
                        "clippy::use-self",
                        "-A",
                        "clippy::inline-always",
                        "-A",
                        "clippy::missing-errors-doc",
                        "-A",
                        "clippy::missing-panics-doc",
                        "-A",
                        "clippy::doc-markdown",
                        "-A",
                        "clippy::used_underscore_binding",
                        "-A",
                        "clippy::significant_drop_tightening",
                        "-A",
                        "clippy::struct-field-names",
                        "-A",
                        "clippy::redundant-pub-crate",
                        "-A",
                        "clippy::unnecessary-wraps",
                    ],
                },
                "rustfmt": {},
            },
        },
        "clangd": {
            "binary": {
                "arguments": [
                    "--function-arg-placeholders=0",
                    // Breaks stuff without compile_commands.json as of clangd 21 i think
                    // "--experimental-modules-support",
                    "--background-index",
                    "--all-scopes-completion",
                    "--clang-tidy",
                    "--malloc-trim",
                    "--header-insertion-decorators=0",
                ],
            },
        },
    },
    "formatter": "auto",
    "tab_bar": {
        "show": false,
    },
    "code_actions_on_format": {
        "source.fixAll": true,
        "source.fixAll.biome": true,
        "quickfix.biome": true,
        "source.sortImports": true,
        "source.addMissingImports.ts": true,
        "source.removeUnusedImports": true,
        "source.organizeImports.biome": true,
        "source.addMissingImports": true,
    },
    "auto_install_extensions": {
        "html": true,
        "catppuccin": true,
        "tombi": true,
        "material-icon-theme": true,
        "latex": true,
        "nix": true,
        "one-dark-pro-max": true,
        "meson": true,
        "git-firefly": true,
        "dockerfile": true,
        "make": true,
        "zig": true,
        "log": true,
        "rainbow-csv": true,
        "ini": true,
        "neocmake": true,
        "python-requirements": true,
    },
    "file_types": {
        "ini": ["wrap", "Doxyfile"],
        "YAML": [".clang-tidy"],
        "Meson": ["meson.build", "meson.options", "meson_options.txt"],
        "JSON": ["spack.lock"],
    },
}
