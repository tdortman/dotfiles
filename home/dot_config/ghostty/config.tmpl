command = zsh
click-repeat-interval = 500
window-decoration = auto
mouse-scroll-multiplier = 6

#custom-shader = ./gears-and-belts.glsl
#custom-shader-animation = true

background-image = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/terminal_background.jpg"
background-image-opacity = 0.05
background-image-fit = cover

font-family = {{ .monospace_font }}

theme = Nocturnal Winter
cursor-style = bar
window-height = 40
window-width = 135
shell-integration-features = sudo,ssh-env
working-directory = home


keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9

keybind = ctrl+enter=unbind

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 20s
