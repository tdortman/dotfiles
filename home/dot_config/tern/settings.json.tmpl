{
  "theme": "Dark",
  "theme_dark": "dark-celestial",
  "overscroll": false,
  "scroll_speed": 400,
  "cursor": {
    "shape": "bar",
    "smooth_blink": true,
    "glide": 80
  },
  "link_click": "Command",
  "link_target": "Browser",
  "font_size": 15,
  "ui_font_size": 15,
  "font_family": "ComicCodeLigatures Nerd Font Mono",
  "ui_font": "Inter",
  "code_font": "ComicCodeLigatures Nerd Font Mono",
  "pane_headers": "Always",
  "widgets": [
    {
      "id": "cwd"
    },
    {
      "id": "git"
    },
    {
      "id": "run"
    },
    {
      "id": "spacer"
    },
    {
      "id": "lines"
    },
    {
      "id": "size"
    },
    {
      "id": "status"
    }
  ],
  "material": "Solid",
  "lenses_disabled": [
    "docs.help"
  ],
  "agents_tray": false,
  "native_prompt": false,
  "auto_update": false,
  "desktop_integration": false,
  "prefs_width": 541,
  "park_pile": 0.8889701962471008,
  "snap_text": true,
  "sync_to_display": false,
  "files": {
    "auto_save": {
      "after_delay": 250
    }
  },
  "file_tree": {
    "open": true,
    "width": 396
  },
  "git": {
    "sidebar_folded": [
      "stashes"
    ],
    "ref_column_width": 108.0,
    "graph_column_width": 113.0,
    "message_column_width": 414.0,
    "inspector_width": 469.0
  },
  "agents": {
    "auto_acp": true,
    "custom": [
      {
        "id": "agy",
        "name": "Antigravity",
        "command": "agy",
        "args": [
          "acp"
        ],
        "env": {}
      },
      {
        "id": "unsafe-agy",
        "name": "Antigravity (unsafe)",
        "command": "unsafe-agy",
        "args": [
          "acp",
          "--dangerously-skip-permissions"
        ],
        "env": {}
      }
    ],
    "own_tools": [
      "codex",
      "claude",
      "copilot",
      "agy",
      "unsafe-agy"
    ]
  },
  "keybinds": {
    "ctrl+shift+x": "markdown.strikethrough"
  }
}