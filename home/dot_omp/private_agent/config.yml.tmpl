modelRoles:
  default: anthropic/claude-fable-5-2:high
  commit: anthropic/claude-sonnet-5-5:medium
  plan: openai-codex/gpt-6-astra:high
  smol: anthropic/claude-haiku-5-5:high
  task: anthropic/claude-sonnet-5-5:high
  slow: openai-codex/gpt-6-astra:medium
  advisor: openai-codex/gpt-6-astra:medium
  tiny: anthropic/claude-haiku-5-5:medium
  designer: openai-codex/gpt-6-astra:medium
  web: openai-codex/gpt-6-luna:high
  judge: typesafe/jev-latest
startup:
  checkUpdate: false
  quiet: false
  changelogMode: expanded
symbolPreset: nerd
stt:
  enabled: false
theme:
  dark: dark-celestial
statusLine:
  preset: default
  separator: powerline-thin
  sessionAccent: false
  showHookStatus: true
  transparent: false
  compactThinkingLevel: false
  contextLine: embedded
terminal:
  showImages: true
  showProgress: true
images:
  autoResize: true
  blockImages: false
  urls:
    enabled: false
display:
  shimmer: classic
  showTokenUsage: false
  tabWidth: 2
compaction:
  thresholdPercent: 80
  thresholdTokens: 500000
  handoffSaveToDisk: false
  methodOrder:
    - remote
    - snapcompact
    - soft
    - shake
    - handoff
  idleEnabled: true
memory:
  backend: mnemopi
edit:
  mode: hashline
  modelVariants:
    codex: apply_patch
lsp:
  formatOnWrite: true
  diagnosticsOnEdit: true
calc:
  enabled: true
checkpoint:
  enabled: true
task:
  isolation:
    merge: patch
    commits: ai
    enabled: true
  enableLsp: false
  maxRecursionDepth: -1
  showResolvedModelBadge: true
  batch: true
  agentAdvisor:
    task: "off"
  enableEffort: false
  perCallModel: "on"
  structured: true
  steps: true
  maxConcurrency: 0
  workerThreads: 4
  autoParallel: "on"
  eager: preferred
secrets:
  enabled: true
contextPromotion:
  enabled: false
renderMermaid:
  enabled: true
providers:
  maxInFlightRequests:
    neuralwatt: 3
  tinyModelDevice: default
  openai-codex:
    codeMode: "on"
  anthropic:
    slowMode: auto
  openaiResponsesWebsockets: true
  openaiLiveSteering: true
setupVersion: 3
python:
  kernelMode: session
dev:
  autoqa: false
  autoqaPush:
    endpoint: ""
advisor:
  enabled: false
  syncBacklog: "off"
completion:
  notify: "on"
features:
  unexpectedStopDetection: smart
snapcompact:
  toolResults: false
  systemPrompt: none
  shape: auto
tools:
  format: auto
  approvalMode: yolo
  speculativeExecution:
    enabled: true
autolearn:
  enabled: true
mnemopi:
  llmMode: smol
  polyphonicRecall: true
  enhancedRecall: true
  recallRelevance: auto
github:
  enabled: true
plan:
  defaultOnStartup: false
defaultThinkingLevel: high
codexResets:
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
hideThinkingBlock: false
branchSummary:
  enabled: false
ttsr:
  contextMode: discard
  repeatMode: after-gap
readLineNumbers: true
doubleEscapeAction: tree
astGrep:
  enabled: true
steeringMode: one-at-a-time
tui:
  tight: false
  textSizing: true
  codexResetFireworks: true
  titleState: true
  hyperlinks: auto
bash:
  autoBackground:
    enabled: true
  direnv: auto
  gitGuard: true
shellMinimizer:
  sourceOutlineLevel: default
generate_image:
  enabled: true
read:
  renderMarkdown: false
externalThinking: false
security:
  enabled: true
computer:
  enabled: true
disabledExtensions:
  - extension-module:herdr-omp-agent-state
  - extension-module:orca-agent-status
  - extension-module:orca-prefill
  - extension-module:orca-titlebar-spinner
composer:
  shape: band
  tokenRate: false
extendedContext: false
isolation:
  backend: auto
treeFilterMode: user-only
retry:
  fallbackChains:
    web:
      - openai-codex/gpt-6-luna
      - anthropic/claude-haiku-5-5
      - openai-codex/gpt-6.1-terra
      - web/perplexity
      - google/gemini-3.8-flash
      - xai/grok-4.5
      - xai-oauth/grok-4.5
      - web/zai
      - web/exa
      - web/tinyfish
      - web/jina
      - web/kagi
      - web/tavily
      - web/firecrawl
      - web/brave
      - web/kimi
      - web/synthetic
      - web/ollama
      - web/searxng
      - web/startpage
      - web/duckduckgo
      - web/ecosia
      - web/google
      - web/mojeek
      - web/public
    judge:
      - "@tiny"
      - "@smol"
      - "@default"
find:
  enabled: "on"
error:
  notify: "on"
claudeResets:
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
spelling:
  autocomplete: {{ if eq .chezmoi.hostname "nixos-laptop" }}auto{{ else }}smollm{{ end }}
web_search:
  enabled: true
emojiAutocomplete: false
eval:
  autoBackground:
    enabled: true
ratchet:
  enabled: true
ida:
  enabled: true
mcp:
  notifications: true