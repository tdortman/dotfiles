+#if HAVE_GBM
+static bool IsNvidiaDrmNode( int nFd )
+{
+	drmVersionPtr pVersion = drmGetVersion( nFd );
+	if ( !pVersion )
+		return false;
+	bool bNvidia = pVersion->name && !strcmp( pVersion->name, "nvidia-drm" );
+	drmFreeVersion( pVersion );
+	return bNvidia;
+}
+
+// Modifiers the backend can present that Vulkan can also import a dmabuf
+// image with, for the usage implied by flags. The GBM buffer is allocated
+// from this list so both sides accept the memory.
+static std::vector<uint64_t> GetGbmScanoutModifiers( uint32_t uDrmFormat, const CVulkanTexture::createFlags &flags )
+{
+	std::vector<uint64_t> modifiers;
+
+	VkImageUsageFlags usage = 0;
+	if ( flags.bSampled )
+		usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+	if ( flags.bStorage )
+		usage |= VK_IMAGE_USAGE_STORAGE_BIT;
+	if ( flags.bTransferSrc )
+		usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+	for ( uint64_t ulModifier : GetBackend()->GetSupportedModifiers( uDrmFormat ) )
+	{
+		if ( ulModifier == DRM_FORMAT_MOD_INVALID )
+			continue;
+
+		VkImageCreateInfo imageInfo = {
+			.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+			.imageType = VK_IMAGE_TYPE_2D,
+			.format = DRMFormatToVulkan( uDrmFormat, false ),
+			.mipLevels = 1,
+			.arrayLayers = 1,
+			.samples = VK_SAMPLE_COUNT_1_BIT,
+			.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+			.usage = usage,
+			.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+		};
+
+		std::array<VkFormat, 2> formats = {
+			DRMFormatToVulkan( uDrmFormat, false ),
+			DRMFormatToVulkan( uDrmFormat, true ),
+		};
+
+		VkImageFormatListCreateInfo formatList = {
+			.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO,
+			.viewFormatCount = (uint32_t)formats.size(),
+			.pViewFormats = formats.data(),
+		};
+
+		if ( formats[0] != formats[1] )
+		{
+			formatList.pNext = std::exchange( imageInfo.pNext, &formatList );
+			imageInfo.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+		}
+
+		VkExternalImageFormatProperties externalImageProperties = {
+			.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+		};
+
+		VkResult res = getModifierProps( &imageInfo, ulModifier, &externalImageProperties );
+		if ( res == VK_SUCCESS &&
+		     ( externalImageProperties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT ) )
+			modifiers.push_back( ulModifier );
+	}
+
+	return modifiers;
+}
+
+// Nested compositors on the NVIDIA proprietary driver: Vulkan-exported
+// images land in scattered vidmem the display engine cannot scan out, so
+// the output images are GBM-allocated (physically contiguous) and imported.
+static bool UseGbmScanoutOutputImages()
+{
+	if ( GetBackend()->UsesVulkanSwapchain() || GetBackend()->IsSessionBased() )
+		return false;
+	// Backends without presentable modifiers (Headless) keep the Vulkan path.
+	if ( !GetBackend()->UsesModifiers() )
+		return false;
+	if ( !g_device.supportsModifiers() )
+		return false;
+	int nRenderFd = g_device.drmRenderFd();
+	if ( nRenderFd < 0 || !IsNvidiaDrmNode( nRenderFd ) )
+		return false;
+	return true;
+}
+
+// Allocate one output-sized GBM buffer and import it. BInit dups everything
+// it keeps, so the bo is destroyed before return: the Vulkan import and
+// m_dmabuf hold their own references alive.
+static bool MakeGbmScanoutOutputImage( VulkanOutput_t *pOutput, uint32_t uIndex, uint32_t uWidth, uint32_t uHeight, uint32_t uDrmFormat, const CVulkanTexture::createFlags &flags, const std::vector<uint64_t> &modifiers, struct gbm_device *pGbm )
+{
+	struct gbm_bo *pBo = gbm_bo_create_with_modifiers2( pGbm, uWidth, uHeight, uDrmFormat, modifiers.data(), modifiers.size(), GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING );
+	if ( !pBo )
+	{
+		vk_log.errorf_errno( "GBM scanout allocation failed" );
+		return false;
+	}
+
+	wlr_dmabuf_attributes attrs = {
+		.width = int32_t( uWidth ),
+		.height = int32_t( uHeight ),
+		.format = uDrmFormat,
+		.modifier = gbm_bo_get_modifier( pBo ),
+	};
+
+	bool bSuccess = false;
+	const int nPlaneCount = gbm_bo_get_plane_count( pBo );
+	if ( ( nPlaneCount < 1 || nPlaneCount > 4 ) ||
+	     !gamescope::Algorithm::Contains( modifiers, attrs.modifier ) )
+	{
+		vk_log.errorf( "GBM scanout buffer has unsupported planes or a modifier outside the allowed list" );
+	}
+	else
+	{
+		bSuccess = true;
+		for ( int i = 0; bSuccess && i < nPlaneCount; i++ )
+		{
+			int nFd = gbm_bo_get_fd_for_plane( pBo, i );
+			if ( nFd < 0 )
+			{
+				vk_log.errorf_errno( "gbm_bo_get_fd_for_plane failed" );
+				bSuccess = false;
+				break;
+			}
+			attrs.fd[i] = nFd;
+			attrs.offset[i] = gbm_bo_get_offset( pBo, i );
+			attrs.stride[i] = gbm_bo_get_stride_for_plane( pBo, i );
+			attrs.n_planes = i + 1;
+		}
+	}
+
+	if ( bSuccess )
+	{
+		pOutput->outputImages[ uIndex ] = new CVulkanTexture();
+		bSuccess = pOutput->outputImages[ uIndex ]->BInit( uWidth, uHeight, 1u, uDrmFormat, flags, &attrs );
+		if ( bSuccess )
+		{
+			vk_log.infof( "GBM scanout output image %u: modifier 0x%llx stride %u", uIndex, (unsigned long long)attrs.modifier, attrs.stride[0] );
+		}
+		else
+		{
+			pOutput->outputImages[ uIndex ] = nullptr;
+			vk_log.errorf( "Failed to import GBM scanout buffer" );
+		}
+	}
+
+	wlr_dmabuf_attributes_finish( &attrs );
+	gbm_bo_destroy( pBo );
+	return bSuccess;
+}
+
+static bool vulkan_make_output_images_gbm( VulkanOutput_t *pOutput, const CVulkanTexture::createFlags &flags, uint32_t uWidth, uint32_t uHeight, uint32_t uDrmFormat )
+{
+	std::vector<uint64_t> modifiers = GetGbmScanoutModifiers( uDrmFormat, flags );
+	if ( modifiers.empty() )
+	{
+		vk_log.errorf( "No modifier is both presentable and Vulkan-importable for GBM scanout" );
+		return false;
+	}
+
+	int nGbmFd = dup( g_device.drmRenderFd() );
+	if ( nGbmFd < 0 )
+	{
+		vk_log.errorf_errno( "Failed to dup render node for GBM" );
+		return false;
+	}
+
+	struct gbm_device *pGbm = gbm_create_device( nGbmFd );
+	if ( !pGbm )
+	{
+		vk_log.errorf( "Failed to create GBM device on the render node" );
+		close( nGbmFd );
+		return false;
+	}
+
+	bool bSuccess = true;
+	for ( uint32_t i = 0; bSuccess && i < 3; i++ )
+		bSuccess = MakeGbmScanoutOutputImage( pOutput, i, uWidth, uHeight, uDrmFormat, flags, modifiers, pGbm );
+
+	gbm_device_destroy( pGbm );
+	close( nGbmFd );
+
+	if ( !bSuccess )
+	{
+		for ( auto &pImage : pOutput->outputImages )
+			pImage = nullptr;
+		return false;
+	}
+	return true;
+}
