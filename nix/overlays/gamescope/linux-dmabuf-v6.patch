+    // linux-dmabuf v6 reports formats/modifiers per GPU tranche. Temporary
+    // parse state for the single default-feedback snapshot taken in Init once
+    // the Vulkan device is known. Every format on sampling tranches for the
+    // selected GPU is kept, including HDR-capable ones.
+    struct DmabufDefaultFeedbackState
+    {
+        struct FormatEntry
+        {
+            uint32_t uFormat;
+            uint32_t uPadding;
+            uint64_t ulModifier;
+        };
+        static_assert( sizeof( FormatEntry ) == 16u );
+
+        const FormatEntry *pTable = nullptr;
+        void *pMap = nullptr;
+        size_t uMapSize = 0;
+        size_t uTableCount = 0;
+
+        bool bTrancheHasTarget = false;
+        dev_t trancheTarget = 0;
+        bool bTrancheHasFlags = false;
+        uint32_t uTrancheFlags = 0;
+        std::vector<uint16_t> trancheIndices;
+
+        dev_t renderDev = 0;
+        dev_t primaryDev = 0;
+        bool bHasPrimaryDev = false;
+
+        std::unordered_map<uint32_t, std::vector<uint64_t>> formatModifiers;
+        bool bFoundSamplingTranche = false;
+        bool bDone = false;
+        bool bMalformed = false;
+        const char *pszMalformedReason = nullptr;
+
+        void UnmapTable()
+        {
+            if ( pMap != nullptr )
+                munmap( pMap, uMapSize );
+            pMap = nullptr;
+            uMapSize = 0;
+            pTable = nullptr;
+            uTableCount = 0;
+        }
+
+        void Fail( const char *pszReason )
+        {
+            if ( !bMalformed )
+            {
+                bMalformed = true;
+                pszMalformedReason = pszReason;
+            }
+        }
+
+        bool TargetIsSelectedGpu( dev_t target ) const
+        {
+            if ( target == renderDev )
+                return true;
+            return bHasPrimaryDev && target == primaryDev;
+        }
+
+        void ResetTranche()
+        {
+            bTrancheHasTarget = false;
+            trancheTarget = 0;
+            bTrancheHasFlags = false;
+            uTrancheFlags = 0;
+            trancheIndices.clear();
+        }
+
+        void OnDone( zwp_linux_dmabuf_feedback_v1 * )
+        {
+            bDone = true;
+        }
+
+        void OnFormatTable( zwp_linux_dmabuf_feedback_v1 *, int32_t fd, uint32_t uSize )
+        {
+            defer( close( fd ) );
+            if ( bMalformed )
+                return;
+            if ( uSize % sizeof( FormatEntry ) != 0u )
+            {
+                Fail( "format table size is not a multiple of 16 bytes" );
+                return;
+            }
+            struct stat tableStat;
+            if ( fstat( fd, &tableStat ) != 0 || tableStat.st_size < 0 || uint64_t( tableStat.st_size ) < uSize )
+            {
+                Fail( "format table fd is invalid or shorter than its advertised size" );
+                return;
+            }
+            UnmapTable();
+            uTableCount = uSize / sizeof( FormatEntry );
+            if ( uTableCount == 0u )
+                return;
+            void *pNewMap = mmap( nullptr, uSize, PROT_READ, MAP_PRIVATE, fd, 0 );
+            if ( pNewMap == MAP_FAILED )
+            {
+                uTableCount = 0u;
+                Fail( "failed to mmap format table" );
+                return;
+            }
+            pMap = pNewMap;
+            uMapSize = uSize;
+            pTable = static_cast<const FormatEntry *>( pMap );
+        }
+
+        void OnTrancheTargetDevice( zwp_linux_dmabuf_feedback_v1 *, wl_array *pDevice )
+        {
+            if ( bMalformed )
+                return;
+            if ( pDevice->size != sizeof( dev_t ) )
+            {
+                Fail( "tranche target device has an unexpected dev_t size" );
+                return;
+            }
+            memcpy( &trancheTarget, pDevice->data, sizeof( dev_t ) );
+            bTrancheHasTarget = true;
+        }
+
+        void OnTrancheFlags( zwp_linux_dmabuf_feedback_v1 *, uint32_t uFlags )
+        {
+            uTrancheFlags = uFlags;
+            bTrancheHasFlags = true;
+        }
+
+        void OnTrancheFormats( zwp_linux_dmabuf_feedback_v1 *, wl_array *pIndices )
+        {
+            if ( bMalformed )
+                return;
+            if ( pIndices->size % sizeof( uint16_t ) != 0u )
+            {
+                Fail( "tranche formats array is not a multiple of 2 bytes" );
+                return;
+            }
+            const uint16_t *pIndex = static_cast<const uint16_t *>( pIndices->data );
+            size_t uCount = pIndices->size / sizeof( uint16_t );
+            for ( size_t i = 0; i < uCount; i++ )
+                trancheIndices.push_back( pIndex[i] );
+        }
+
+        void OnTrancheDone( zwp_linux_dmabuf_feedback_v1 * )
+        {
+            if ( bMalformed )
+            {
+                ResetTranche();
+                return;
+            }
+            if ( !bTrancheHasTarget )
+            {
+                Fail( "tranche is missing its target device" );
+                ResetTranche();
+                return;
+            }
+            if ( !bTrancheHasFlags )
+            {
+                Fail( "tranche is missing its flags" );
+                ResetTranche();
+                return;
+            }
+            bool bSampling = ( uTrancheFlags & ZWP_LINUX_DMABUF_FEEDBACK_V1_TRANCHE_FLAGS_SAMPLING ) != 0u;
+            if ( bSampling && TargetIsSelectedGpu( trancheTarget ) )
+            {
+                bFoundSamplingTranche = true;
+                for ( uint16_t uIndex : trancheIndices )
+                {
+                    if ( pTable == nullptr || size_t( uIndex ) >= uTableCount )
+                    {
+                        Fail( "tranche format index is out of bounds" );
+                        break;
+                    }
+                    const FormatEntry &entry = pTable[ uIndex ];
+                    std::vector<uint64_t> &modifiers = formatModifiers[ entry.uFormat ];
+                    bool bKnown = false;
+                    for ( uint64_t ulKnown : modifiers )
+                    {
+                        if ( ulKnown == entry.ulModifier )
+                        {
+                            bKnown = true;
+                            break;
+                        }
+                    }
+                    if ( !bKnown )
+                        modifiers.push_back( entry.ulModifier );
+                }
+            }
+            ResetTranche();
+        }
+    };
+
+    static constexpr zwp_linux_dmabuf_feedback_v1_listener s_DmabufDefaultFeedbackListener =
+    {
+        .done                  = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnDone ),
+        .format_table          = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnFormatTable ),
+        .main_device           = WAYLAND_NULL(),
+        .tranche_done          = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnTrancheDone ),
+        .tranche_target_device = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnTrancheTargetDevice ),
+        .tranche_formats       = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnTrancheFormats ),
+        .tranche_flags         = WAYLAND_USERDATA_TO_THIS( DmabufDefaultFeedbackState, OnTrancheFlags ),
+    };
+
+    bool CWaylandBackend::InitDmabufDefaultFeedback()
+    {
+        int nRenderFd = g_device.drmRenderFd();
+        if ( nRenderFd < 0 )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: no DRM render fd selected, cannot match a feedback tranche to the GPU." );
+            return false;
+        }
+
+        struct stat renderStat{};
+        if ( fstat( nRenderFd, &renderStat ) != 0 )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: failed to stat the selected DRM render node." );
+            return false;
+        }
+
+        DmabufDefaultFeedbackState state;
+        defer( state.UnmapTable() );
+        state.renderDev = renderStat.st_rdev;
+        state.bHasPrimaryDev = g_device.hasDrmPrimaryDevId();
+        if ( state.bHasPrimaryDev )
+            state.primaryDev = g_device.primaryDevId();
+
+        zwp_linux_dmabuf_feedback_v1 *pFeedback = zwp_linux_dmabuf_v1_get_default_feedback( m_pLinuxDmabuf );
+        if ( !pFeedback )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: failed to create the default feedback object." );
+            return false;
+        }
+        defer( zwp_linux_dmabuf_feedback_v1_destroy( pFeedback ) );
+
+        zwp_linux_dmabuf_feedback_v1_add_listener( pFeedback, &s_DmabufDefaultFeedbackListener, &state );
+
+        while ( !state.bDone && !state.bMalformed )
+        {
+            if ( wl_display_dispatch( m_pDisplay ) < 0 )
+            {
+                xdg_log.errorf_errno( "linux-dmabuf v6: dispatch failed while collecting default feedback" );
+                return false;
+            }
+        }
+
+        if ( state.bMalformed )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: malformed default feedback (%s).", state.pszMalformedReason ? state.pszMalformedReason : "unknown" );
+            return false;
+        }
+        if ( !state.bFoundSamplingTranche )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: no sampling tranche for the selected GPU." );
+            return false;
+        }
+        if ( state.formatModifiers.empty() )
+        {
+            xdg_log.errorf( "linux-dmabuf v6: selected GPU sampling tranches advertised no formats." );
+            return false;
+        }
+
+        m_FormatModifiers = std::move( state.formatModifiers );
+        m_bCanUseModifiers = false;
+        for ( const auto &pair : m_FormatModifiers )
+        {
+            for ( uint64_t ulModifier : pair.second )
+            {
+                if ( ulModifier != DRM_FORMAT_MOD_INVALID )
+                {
+                    m_bCanUseModifiers = true;
+                    break;
+                }
+            }
+            if ( m_bCanUseModifiers )
+                break;
+        }
+        m_SamplingDevId = state.renderDev;
+
+        xdg_log.infof( "linux-dmabuf v6: using %zu format(s) from the selected GPU sampling tranche(s).", m_FormatModifiers.size() );
+
+        return true;
+    }
+
     void CWaylandBackend::Wayland_Modifier( zwp_linux_dmabuf_v1 *pDmabuf, uint32_t uFormat, uint32_t uModifierHi, uint32_t uModifierLo )
     {
         uint64_t ulModifier = ( uint64_t( uModifierHi ) << 32 ) | uModifierLo;
