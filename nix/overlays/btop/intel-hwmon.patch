+		static bool hwmon_has_prev = false;
+		// Locate temp1_input/energy1_input under the same detected <gpu_path>/device/hwmon/hwmon*.
+		// Seeds energy baseline so first collect<1> pushes real watts (never empty+true, never fake 0).
+		static void discover_intel_hwmon(const char* gpu_path) {
+			try {
+				const fs::path base = fs::path(gpu_path) / "device" / "hwmon";
+				if (!fs::exists(base)) return;
+				for (const auto& e : fs::directory_iterator(base)) {
+					if (!e.is_directory()) continue;
+					if (hwmon_temp_path.empty() && fs::exists(e.path() / "temp1_input"))
+						hwmon_temp_path = e.path() / "temp1_input";
+					if (hwmon_energy_path.empty() && fs::exists(e.path() / "energy1_input")) {
+						hwmon_energy_path = e.path() / "energy1_input";
+						const std::string max_s = readfile(e.path() / "power1_max", "");
+						if (!max_s.empty()) hwmon_pwr_max = std::stoll(max_s) / 1000;
+						if (hwmon_pwr_max <= 0) hwmon_pwr_max = std::stoll(readfile(e.path() / "power1_rated_max", "0")) / 1000;
+					}
+					if (!hwmon_temp_path.empty() && !hwmon_energy_path.empty()) break;
+				}
+				if (!hwmon_energy_path.empty()) {
+					try {
+						const std::string e0 = readfile(hwmon_energy_path, "");
+						const long long v0 = e0.empty() ? 0 : std::stoll(e0);
+						if (v0 > 0) {
+							hwmon_prev_energy = v0;
+							hwmon_prev_time = get_monotonicTimeUSec();
+							hwmon_has_prev = true;
+						} else hwmon_energy_path.clear();
+					} catch (const std::exception& e) {
+						Logger::warning("Intel GPU hwmon energy baseline failed ({}), power disabled", e.what());
+						hwmon_energy_path.clear();
+					}
+				}
+			} catch (const std::exception& e) {
+				Logger::warning("Intel GPU hwmon discovery failed ({}), hwmon disabled", e.what());
+				if (!hwmon_has_prev) hwmon_energy_path.clear();
+			}
+		}
 	}
 }
 
