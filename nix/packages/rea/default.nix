{
  lib,
  stdenv,
  fetchurl,
  android-tools,
  apktool,
  autoPatchelfHook,
  binutils-unwrapped,
  binwalk,
  buildNpmPackage,
  gdb,
  ghidra,
  google-chrome,
  ilspycmd,
  jdk21,
  makeWrapper,
  nodejs_26,
  python3,
  rizin,
  runCommand,
  sigrok-cli,
  unblob,
  util-linux,
  wabt,
  wireshark-cli,
}:

let
  cli = buildNpmPackage {
    inherit src version;
    pname = "rea-agents";
    nativeBuildInputs = [ makeWrapper ];
    npmDepsHash = depsHash;

    postInstall = ''
      # The CLI shells out to node and to the Python bridges.
      for program in rea rea-agents; do
        wrapProgram $out/bin/$program --prefix PATH : ${
          lib.makeBinPath [
            nodejs_26
            python3
          ]
        }
      done
    '';

    # dist/ is prebuilt in the published tarball, and its install hooks are not
    # needed to run the CLI.
    dontNpmBuild = true;
    # package.json engines rejects the nodejs 24 nixpkgs ships.
    nodejs = nodejs_26;
    npmFlags = [ "--ignore-scripts" ];
  };
  depsHash = "sha256-3WPXD+qm5WVfrTEvepKwX5RZBfbLBcPB0uDmKIx4MR8=";
  # REA only runs tools from absolute paths it is given; --set-default lets a
  # caller's environment still override each one.
  env = {
    GHIDRA_INSTALL_DIR = "${ghidra}/lib/ghidra";
    JAVA_HOME = "${jdk21}";
    REA_ADB_PATH = lib.getExe' android-tools "adb";
    REA_APKTOOL_COMMAND = lib.getExe apktool;
    REA_BINWALK_COMMAND = lib.getExe binwalk;
    REA_BROWSER_EXECUTABLE = lib.getExe' google-chrome "google-chrome-stable";
    REA_CAPINFOS_COMMAND = lib.getExe' wireshark-cli "capinfos";
    REA_EVM_PRLIMIT_COMMAND = prlimit;
    REA_FIRMWARE_PRLIMIT_COMMAND = prlimit;
    REA_GDB_COMMAND = lib.getExe gdb;
    REA_ILSPY_CMD_PATH = lib.getExe ilspycmd;
    REA_JADX_MCP_JAR = "${fetchPin pins.build.jadx-headless-mcp}";
    REA_JAVASCRIPT_PRLIMIT_COMMAND = prlimit;
    REA_MITMDUMP_COMMAND = lib.getExe' mitmproxy "mitmdump";
    REA_OBJDUMP_COMMAND = lib.getExe' binutils-unwrapped "objdump";

    REA_PWNTOOLS_PYTHON = lib.getExe (
      python3.withPackages (ps: [
        ps.pwntools
        ps.pyelftools
        ps.unicorn
      ])
    );

    REA_RIZIN_COMMAND = lib.getExe rizin;
    REA_SIGROK_COMMAND = lib.getExe sigrok;
    REA_SIGROK_PRLIMIT_COMMAND = prlimit;
    REA_TSHARK_COMMAND = lib.getExe' wireshark-cli "tshark";
    REA_TSHARK_PRLIMIT_COMMAND = prlimit;
    REA_UNBLOB_COMMAND = lib.getExe unblob;
    REA_WABT_BIN_DIRECTORY = "${wabtPinned}/bin";
    REA_WAKARU_COMMAND = "${wakaru}/bin/wakaru";
  };
  fetchPin = pin: fetchurl { inherit (pin) hash url; };
  lockHash = "sha256-HY+g8zsxJdPmAeyDKxjZ01s3RT82NA3AUH8GWo3hWK0=";
  # REA accepts these from nixpkgs within a release line, matched by pins.nixpkgs.
  nixpkgsTools = {
    inherit
      binwalk
      ghidra
      unblob
      ;
  };
  package =
    runCommand "rea-${version}"
      {
        nativeBuildInputs = [ makeWrapper ];

        passthru = {
          inherit cli;
          nodejs = nodejs_26;
        };

        meta = {
          description = "MCP server and CLI that give agents reverse-engineering tools for binaries, apps and runtime behaviour";
          homepage = "https://github.com/morluto/rea";
          changelog = "https://github.com/morluto/rea/releases/tag/rea-agents-${version}";
          license = lib.licenses.mit;
          # google-chrome and the wakaru binary are x86_64 only.
          platforms = [ "x86_64-linux" ];
          mainProgram = "rea";
        };
      }
      ''
        for program in rea rea-agents; do
          makeWrapper ${cli}/bin/$program $out/bin/$program ${
            lib.concatStringsSep " " (
              lib.mapAttrsToList (name: value: "--set-default ${name} ${lib.escapeShellArg value}") env
            )
          }
        done
      '';
  # Generated by update.sh from the release's own dist/ modules.
  pins = lib.importJSON ./pins.json;
  prlimit = lib.getExe' util-linux "prlimit";
  # REA admits these only at the exact release it audited.
  mitmproxy = python3.pkgs.toPythonApplication (
    python3.pkgs.mitmproxy.overridePythonAttrs (old: {
      inherit (pins.build.mitmproxy) version;
      src = fetchPin pins.build.mitmproxy;
      # 12.3 replaced zstandard with backports-zstd, which nixpkgs follows.
      dependencies = old.dependencies ++ [ python3.pkgs.zstandard ];
    })
  );
  sigrok = sigrok-cli.overrideAttrs {
    inherit (pins.build.sigrok-cli) version;
    src = fetchPin pins.build.sigrok-cli;
  };
  # The registry tarball ships the built dist/ and the bridge sources, but not the
  # lockfile npm needs to resolve the runtime dependencies.
  src = runCommand "rea-agents-${version}-src" { } ''
    mkdir -p $out
    tar -xzf ${
      fetchurl {
        url = "https://registry.npmjs.org/rea-agents/-/rea-agents-${version}.tgz";
        hash = tarballHash;
      }
    } -C $out --strip-components=1
    cp ${
      fetchurl {
        url = "https://raw.githubusercontent.com/morluto/rea/rea-agents-${version}/package-lock.json";
        hash = lockHash;
      }
    } $out/package-lock.json
  '';
  tarballHash = "sha256-jVQux2qcs1BYS2CmycCIcG/4EtW7WwlMIMlbbcJWmLs=";
  version = "6.8.0";
  wabtPinned = wabt.overrideAttrs {
    inherit (pins.build.wabt) version;
    src = fetchPin pins.build.wabt;
  };
  wakaru = stdenv.mkDerivation {
    inherit (pins.build.wakaru) version;
    pname = "wakaru";
    # The npm wrapper package only re-exports this platform package, which holds
    # the self-contained binary.
    src = fetchPin pins.build.wakaru;
    nativeBuildInputs = [ autoPatchelfHook ];
    # The binary links against libgcc_s from the C toolchain.
    buildInputs = [ stdenv.cc.cc.lib ];

    installPhase = ''
      runHook preInstall
      install -Dm755 wakaru $out/bin/wakaru
      runHook postInstall
    '';

    sourceRoot = "package";
  };
in
lib.foldlAttrs (
  drv: name: pattern:
  let
    toolVersion = nixpkgsTools.${name}.version;
  in
  lib.warnIf (builtins.match pattern toolVersion == null)
    "rea ${version}: nixpkgs ${name} ${toolVersion} is outside the release line REA accepts (${pattern})"
    drv
) package pins.nixpkgs
